JOBPICKY_APP_NAME=JobPicky
JOBPICKY_ENVIRONMENT=development
JOBPICKY_LOG_LEVEL=INFO
JOBPICKY_DATABASE_URL=postgresql+asyncpg://jobpicky:jobpicky@localhost:5432/jobpicky

# Local embedding model (BAAI/bge-small-zh-v1.5, 512 dimensions)
JOBPICKY_EMBEDDING_PROVIDER=local
JOBPICKY_EMBEDDING_MODEL_PATH=~/.cache/huggingface/hub/models--BAAI--bge-small-zh-v1.5
JOBPICKY_EMBEDDING_QUERY_TIMEOUT_SECONDS=5
JOBPICKY_EMBEDDING_BACKFILL_TIMEOUT_SECONDS=60
JOBPICKY_EMBEDDING_BATCH_SIZE=32

# LLM evaluation (qwen-mt-flash is translation-only and not compatible with the current evaluator)
JOBPICKY_LLM_PROVIDER=dashscope
JOBPICKY_LLM_MODEL=qwen3-32b
JOBPICKY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOBPICKY_DASHSCOPE_API_KEY=
JOBPICKY_LLM_TIMEOUT_SECONDS=180
JOBPICKY_LLM_MAX_RETRIES=1
JOBPICKY_EVALUATION_BATCH_SIZE=5
JOBPICKY_MODEL_CONFIG_VERSION=recommendation-v1-qwen3-32b

# Public job pool and recommendation limits
JOBPICKY_VISIBLE_POOL_LIMIT=5000
JOBPICKY_JOB_POOL_DEFAULT_PAGE_SIZE=30
JOBPICKY_JOB_POOL_PUBLIC_PAGE_SIZE_MAX=30
JOBPICKY_JOB_POOL_AUTHENTICATED_PAGE_SIZE_MAX=100
JOBPICKY_RECOMMENDATION_DEFAULT_PAGE_SIZE=10
JOBPICKY_RECOMMENDATION_PAGE_SIZE_MAX=50
JOBPICKY_RECOMMENDATION_RUN_DEFAULT_PAGE_SIZE=20
JOBPICKY_RECOMMENDATION_RUN_PAGE_SIZE_MAX=100
JOBPICKY_RECOMMENDATION_RESULT_DEFAULT_PAGE_SIZE=10
JOBPICKY_RECOMMENDATION_RESULT_PAGE_SIZE_MAX=50
JOBPICKY_SAVED_JOBS_DEFAULT_PAGE_SIZE=10
JOBPICKY_SAVED_JOBS_PAGE_SIZE_MAX=50
JOBPICKY_RECOMMENDATION_CANDIDATE_LIMIT=50
JOBPICKY_SIGNUP_BONUS_CREDITS=10000
JOBPICKY_RECOMMENDATION_COST=100
JOBPICKY_JOB_DESCRIPTION_PREVIEW_LENGTH=240
JOBPICKY_IDEMPOTENCY_KEY_MAX_LENGTH=128

# Authentication and session security
# Set a random value of at least 32 bytes outside local development.
JOBPICKY_JWT_ISSUER=jobpicky
JOBPICKY_JWT_AUDIENCE=jobpicky-api
JOBPICKY_JWT_ALGORITHM=HS256
JOBPICKY_JWT_SIGNING_KEY=
JOBPICKY_ACCESS_TOKEN_TTL_SECONDS=900
JOBPICKY_REFRESH_SESSION_TTL_SECONDS=2592000
JOBPICKY_REFRESH_COOKIE_NAME=refresh_token
JOBPICKY_REFRESH_COOKIE_SECURE=false
JOBPICKY_REFRESH_COOKIE_SAMESITE=lax
JOBPICKY_REFRESH_COOKIE_PATH=/api/v1/auth
JOBPICKY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
JOBPICKY_REGISTER_IP_LIMIT_PER_HOUR=5
JOBPICKY_LOGIN_EMAIL_FAILURE_LIMIT=5
JOBPICKY_LOGIN_IP_ATTEMPT_LIMIT=30
JOBPICKY_REFRESH_SESSION_LIMIT_PER_MINUTE=10
JOBPICKY_REFRESH_IP_LIMIT_PER_MINUTE=60
