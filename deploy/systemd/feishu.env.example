# Copy to /etc/jobpicky/feishu.env and chmod 600.
JOBPICKY_DATABASE_URL=postgresql+asyncpg://jobpicky:change-me@127.0.0.1:5432/jobpicky
JOBPICKY_FEISHU_APP_ID=replace-with-app-id
JOBPICKY_FEISHU_APP_SECRET=replace-with-app-secret
JOBPICKY_FEISHU_APP_TOKEN=replace-with-bitable-app-token
JOBPICKY_FEISHU_TABLE_ID=replace-with-table-id
JOBPICKY_FEISHU_VIEW_ID=replace-with-view-id
JOBPICKY_FEISHU_SINCE_DATE=2026-06-20
JOBPICKY_FEISHU_TOKEN_FILE=/var/lib/jobpicky/feishu-token.json
JOBPICKY_FEISHU_LOCK_FILE=/var/cache/jobpicky/feishu.lock
JOBPICKY_FEISHU_OAUTH_SCOPE="bitable:app:readonly offline_access"
